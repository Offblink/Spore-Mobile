<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LLM/检索网络层（OkHttp + SSE）在原生域，权限先给足 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 悬浮球/浮层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 扫码配对（PairActivity 取景） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 前台服务 + 截屏类型（Android 14+ 硬要求）；specialUse = 14+ 拿投影前的过渡类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 通知权限（前台服务通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SporeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spore"
        android:usesCleartextTraffic="true"><!-- 同步/配对连的是桌面端 http://<局域网IP>:8080
             （design/02 Base URL 就是明文 http，桌面无 TLS）；targetSdk 28+ 默认拦明文，
             不开就报 CLEARTEXT not permitted。只放行 http，https 不受影响 -->

        <!-- 启动页（白底五字母 + 弧线飞点，见 splash.html）→ 页面起来 1.5s 后进主页 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Spore.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主页（web 皮）：承载悬浮球开关与权限引导；启动页跳入，非桌面入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 设置页（端点/key/模型/检索代理/两阶段开关） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 搜题记录（会话列表 + 收藏筛选 + 改名/删除；点行开面板接着对话） -->
        <activity
            android:name=".RecordActivity"
            android:exported="false" />

        <!-- 扫码配对（相机取景扫 Spore-GUI 主窗头像二维码 → 连通校验 → 落配对态） -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 悬浮球与截屏采集共用的前台服务；Android 14+ 要求 mediaProjection 类型，
             specialUse 供「授权前」的启动过渡（见 CaptureService.startAsForeground） -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spore_ball_overlay_and_screen_capture_consent_flow" />
        </service>

    </application>

</manifest>
