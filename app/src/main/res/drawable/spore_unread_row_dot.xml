<?xml version="1.0" encoding="utf-8"?>
<!-- 行内未读点（MV3 .row .d：品牌粉 + 粉光晕；顶栏是 danger 红，行内是粉，两端同款配色） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#5FEC4899" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/spore_pink" />
        </shape>
    </item>
</layer-list>
