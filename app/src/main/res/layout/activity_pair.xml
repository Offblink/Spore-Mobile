<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码配对（PairActivity）：全屏相机预览 + 半透暗幕 + 粉框取景窗 + 顶栏 + 底部提示 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/pair_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <View
        android:id="@+id/pair_frame"
        android:layout_width="248dp"
        android:layout_height="248dp"
        android:layout_gravity="center"
        android:background="@drawable/spore_pair_frame" />

    <!-- 顶栏：✕（关闭） · 标题 · ⚡（闪光灯） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/pair_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/spore_pair_btn"
            android:clickable="true"
            android:contentDescription="@string/pair_close_cd"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/pair_close_cd"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/pair_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pair_torch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/spore_pair_btn"
            android:clickable="true"
            android:contentDescription="@string/pair_torch"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/pair_torch"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/pair_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/pair_hint"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pair_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pair_scanning"
            android:textColor="@color/spore_pink"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
