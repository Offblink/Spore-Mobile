<?xml version="1.0" encoding="utf-8"?>
<!-- 拍照搜题（PhotoActivity）：全屏相机预览（取景态）/ 冻结帧框选（拍完态，应用内不走悬浮窗）。
     顶栏恒定三段：左「取消」· 标题 · 右「↻ 旋转」（仅拍完态出现）；
     底部在两态间互斥：取景 = 快门 + 提示；拍完 = 只有一个「确定」 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/photo_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏：FrameLayout 绝对居中（不被左侧取消、右侧旋转的宽度挤偏） -->
    <FrameLayout
        android:id="@+id/photo_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/photo_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/photo_cancel"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/photo_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/photo_rotate"
            android:gravity="center"
            android:text="@string/photo_rotate_glyph"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部：取景态 = 提示 + 快门 -->
    <LinearLayout
        android:id="@+id/photo_bottom_viewfinder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/photo_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/photo_hint"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/photo_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/spore_shutter"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 拍完态：底部只有一个「确定」 -->
    <TextView
        android:id="@+id/photo_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/spore_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:text="@string/photo_confirm"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
