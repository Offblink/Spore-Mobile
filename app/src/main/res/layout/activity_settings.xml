<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶栏：← 返回（点了 finish）+ 页面标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_back_cd"
                android:padding="8dp"
                android:text="@string/settings_back"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_title"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 接口地址 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_endpoint"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />

        <!-- 模型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_model"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <!-- API Key（密码形态，仅存本机） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_api_key"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_api_key_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- 检索代理（留空=只走 bing） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_proxy"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_proxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_proxy_hint"
            android:inputType="text"
            android:singleLine="true" />

        <!-- 最大工具轮数（数字） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_max_tool_rounds"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_max_tool_rounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_max_tool_rounds_hint"
            android:inputType="number"
            android:singleLine="true" />

        <!-- 历史记录条数（数字） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_history_limit"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_history_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_history_limit_hint"
            android:inputType="number"
            android:singleLine="true" />

        <!-- 两阶段开关 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_fast_no_think"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_fast_no_think"
            android:textSize="15sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_auto_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_auto_verify"
            android:textSize="15sp" />

        <!-- 保存 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_save" />

    </LinearLayout>
</ScrollView>
