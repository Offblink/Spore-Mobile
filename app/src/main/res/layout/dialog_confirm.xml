<?xml version="1.0" encoding="utf-8"?>
<!-- 删除确认（MV3 #confirm 同构：316px 白盒、650 标题、红确证按钮、pop 入场） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spore_dialog_overlay"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spore_dialog_box"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/confirm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_title"
            android:textColor="@color/spore_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirm_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingMultiplier="1.7"
            android:textColor="@color/spore_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/confirm_no"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_ghost"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/spore_chip_text"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confirm_yes"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_danger"
                android:gravity="center"
                android:text="@string/delete_yes"
                android:textColor="@color/spore_surface"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
