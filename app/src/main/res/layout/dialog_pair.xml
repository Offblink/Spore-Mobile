<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码后的配对确认框内容：可改接口地址（回环 IP 场景必改）+ token 摘要 + 错误行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pair_api_label"
        android:textColor="@color/spore_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/pair_api"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:hint="http://192.168.1.5:8080/api"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:selectAllOnFocus="true"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/pair_loopback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pair_api_hint_loopback"
        android:textColor="@color/spore_danger_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/pair_token_label"
        android:textColor="@color/spore_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pair_token"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/spore_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/pair_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/spore_danger_text"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>
