<?xml version="1.0" encoding="utf-8"?>
<!-- 扫码配对确认框（dialog_rename 同族皮）：暗幕 + 白卡 + 标签 + 粉焦点输入 + ghost/primary 按钮。
     宿主是 SporePairDialog 主题的 Dialog（无原生标题栏/系统按钮） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spore_dialog_overlay"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spore_dialog_box"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_title"
            android:textColor="@color/spore_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pair_api_label"
            android:textColor="@color/spore_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pair_api"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/spore_input_field"
            android:hint="http://192.168.1.5:8080/api"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/spore_ink"
            android:textColorHint="@color/spore_placeholder"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pair_loopback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pair_api_hint_loopback"
            android:textColor="@color/spore_danger_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pair_token_label"
            android:textColor="@color/spore_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pair_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/spore_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pair_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/spore_danger_text"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pair_cancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/spore_chip_text"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pair_connect"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/pair_connect"
                android:textColor="@color/spore_surface"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
