<?xml version="1.0" encoding="utf-8"?>
<!-- 重命名（MV3 #rename 同构：白盒、粉焦点输入、取消/保存） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spore_dialog_overlay"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/spore_dialog_box"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rename_title"
            android:textColor="@color/spore_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/rename_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/spore_input_field"
            android:hint="@string/rename_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="60"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/spore_ink"
            android:textColorHint="@color/spore_placeholder"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rename_no"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_ghost"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/spore_chip_text"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rename_yes"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/spore_btn_primary"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/spore_surface"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
