<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/row_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:paddingVertical="2dp"
        android:textColor="@color/spore_label"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_think"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.62"
        android:paddingBottom="4dp"
        android:textColor="@color/spore_think"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/spore_ink"
        android:textSize="17.5sp" />

    <LinearLayout
        android:id="@+id/row_verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/verify_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/spore_seglite"
                android:letterSpacing="0.04"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/spore_chip_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/verify_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/spore_vnote"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/verify_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/spore_btn_soft"
            android:gravity="center"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/verify_now"
            android:textColor="@color/spore_pink_deep"
            android:textSize="13sp"
            android:visibility="gone"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/spore_muted2"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
