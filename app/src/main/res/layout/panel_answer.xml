<?xml version="1.0" encoding="utf-8"?>
<!-- 回答面板：MV3 白抽屉同款（白底、600 标题、💬/★/■/— 顶栏、粉焦点输入、
     listpop 会话弹层与两个 in-panel 模态都在同一层叠内，照桌面结构） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spore_surface">

    <LinearLayout
        android:id="@+id/panel_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：💬（会话列表+未读点） ★ 标题…状态 ■停止 —收起 -->
        <LinearLayout
            android:id="@+id/panel_header"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/spore_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:id="@+id/panel_sessions"
                android:layout_width="34dp"
                android:layout_height="34dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/panel_sessions"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/panel_unread"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="right|top"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/spore_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/panel_fav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:padding="6dp"
                android:text="@string/panel_fav"
                android:textColor="@color/spore_muted4"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/spore_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panel_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/spore_muted3"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/panel_stop"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:contentDescription="@string/panel_stop_desc"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/panel_stop"
                android:textColor="@color/spore_muted3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/panel_min"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:contentDescription="@string/panel_min_desc"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/panel_min"
                android:textColor="@color/spore_muted3"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/spore_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/spore_divider" />

        <!-- 输入区（MV3 composer：12 圆角粉焦点输入 + 40 粉方 ↑） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/spore_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <EditText
                android:id="@+id/panel_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/spore_input_field"
                android:hint="@string/panel_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:textColor="@color/spore_ink"
                android:textColorHint="@color/spore_placeholder"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/panel_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/spore_btn_primary"
                android:contentDescription="@string/panel_send_desc"
                android:gravity="center"
                android:text="@string/panel_send"
                android:textColor="@color/spore_surface"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- listpop 遮罩：点弹层外任意空白即关（第六轮原生补，照 web 点外面关的行为） -->
    <View
        android:id="@+id/panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:visibility="gone" />

    <!-- MV3 listpop：会话弹层（默认隐藏，💬 展开，pop 动画） -->
    <ScrollView
        android:id="@+id/panel_listpop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/spore_card"
        android:elevation="10dp"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panel_listrows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/panel_listempty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:background="@drawable/spore_card"
        android:elevation="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:text="@string/session_empty"
        android:textColor="@color/spore_muted3"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <!-- 删除确认（in-panel 模态，桌面 #confirm 同构） -->
    <LinearLayout
        android:id="@+id/panel_confirm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:background="@drawable/spore_dialog_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spore_dialog_box"
            android:elevation="14dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_title"
                android:textColor="@color/spore_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panel_confirm_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="18dp"
                android:lineSpacingMultiplier="1.7"
                android:textColor="@color/spore_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/panel_confirm_no"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/spore_btn_ghost"
                    android:gravity="center"
                    android:text="@string/cancel"
                    android:textColor="@color/spore_chip_text"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/panel_confirm_yes"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/spore_btn_danger"
                    android:gravity="center"
                    android:text="@string/delete_yes"
                    android:textColor="@color/spore_surface"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 重命名（in-panel 模态，桌面 #rename 同构） -->
    <LinearLayout
        android:id="@+id/panel_rename"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:background="@drawable/spore_dialog_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spore_dialog_box"
            android:elevation="14dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rename_title"
                android:textColor="@color/spore_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/panel_rename_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/spore_input_field"
                android:hint="@string/rename_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="60"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/spore_ink"
                android:textColorHint="@color/spore_placeholder"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/panel_rename_no"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/spore_btn_ghost"
                    android:gravity="center"
                    android:text="@string/cancel"
                    android:textColor="@color/spore_chip_text"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/panel_rename_yes"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/spore_btn_primary"
                    android:gravity="center"
                    android:text="@string/save"
                    android:textColor="@color/spore_surface"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
