<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MV3 桌面只有浅色一套 → 锁 Light，杜绝系统深色把粉系咬坏（Page Theme Lock） -->
    <style name="Base.Theme.Spore" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/spore_pink</item>
        <item name="colorOnPrimary">@color/spore_surface</item>
        <item name="colorSecondary">@color/spore_pink</item>
        <item name="android:statusBarColor">@color/spore_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/spore_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Spore" parent="Base.Theme.Spore" />

    <!-- 应用皮对话框（扫码配对 / 取消配对）：透明窗口 + 布局自带暗幕，
         零原生 chrome——Material alert 的标题栏与系统按钮一概不出现（2026-10-03 用户拍板） -->
    <style name="SporePairDialog" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
