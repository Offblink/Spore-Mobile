<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MV3 桌面只有浅色一套 → 锁 Light，杜绝系统深色把粉系咬坏（Page Theme Lock） -->
    <style name="Base.Theme.Spore" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/spore_pink</item>
        <item name="colorOnPrimary">@color/spore_surface</item>
        <item name="colorSecondary">@color/spore_pink</item>
        <item name="android:statusBarColor">@color/spore_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/spore_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- 页面平移切页（page-transition-spec）：主题一处接管，所有页面不用逐个调 -->
        <item name="android:windowAnimationStyle">@style/SporeAnim</item>
    </style>

    <!-- 平移分页：进 = 新页右滑入/旧页左让位；回 = 底下页左归位/当前页右滑出（严格反动作） -->
    <style name="SporeAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.Spore" parent="Base.Theme.Spore" />

    <!-- 启动页：纯白窗口底（系统 splash → 本页无缝），内容见 splash.html。
         31+ 的两条 windowSplashScreen* 属性挪到 values-v31（见同名文件）：
         那两个属性是 API 31 才有的，放基线里 minSdk 26 过不了 lint 的 NewApi，
         且 lint 明确要求走 values-vNN（OEM 自定义属性 id 可能撞车）。 -->
    <style name="Theme.Spore.Splash" parent="Theme.Spore">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <!-- 题图圆角：原生面板 user 行的 ShapeableImageView 用（web .msg.user .shot
         border-radius:12px 同款）。显式 parent=""：别让它按名字隐式继承 ShapeAppearance.Spore -->
    <style name="ShapeAppearance.Spore.Shot" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- 应用皮对话框（扫码配对 / 取消配对）：透明窗口 + 布局自带暗幕，
         零原生 chrome——Material alert 的标题栏与系统按钮一概不出现（2026-10-03 用户拍板） -->
    <style name="SporePairDialog" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
